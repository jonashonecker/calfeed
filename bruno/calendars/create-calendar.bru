meta {
  name: Create calendar
  type: http
  seq: 1
}

post {
  url: {{base_url}}/calendars
  body: json
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

body:json {
  {
    "name": "Family"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("calendar_id", res.body.id);
    bru.setEnvVar("calendar_token", res.body.token);
    bru.setEnvVar("subscribe_url", res.body.subscribe_url);
  }
}

docs {
  Creates a calendar (administrator token). Saves calendar_id,
  calendar_token, and subscribe_url into the environment, so every
  other request works right away.
}
