meta {
  name: Create calendar
  type: http
  seq: 1
}

post {
  url: {{base_url}}/calendars
  body: json
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

body:json {
  {
    "name": "Family"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("calendar_id", res.body.id);
    bru.setVar("calendar_token", res.body.token);
    bru.setVar("subscribe_url", res.body.subscribe_url);
  }
}

docs {
  Creates a calendar (administrator token). Saves calendar_id,
  calendar_token, and subscribe_url as runtime variables for this
  session, so every other request works right away. Runtime variables
  are never written to disk.
}
