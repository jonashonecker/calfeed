meta {
  name: Set feed password
  type: http
  seq: 3
}

put {
  url: {{base_url}}/calendars/{{calendar_id}}/feed-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{calendar_token}}
}

body:json {
  {
    "password": "s3cret"
  }
}

docs {
  Turns HTTP Basic authentication on for the feed. Send null (or "")
  as the password to turn it off again.
}
