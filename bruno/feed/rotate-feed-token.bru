meta {
  name: Rotate feed token
  type: http
  seq: 2
}

post {
  url: {{base_url}}/calendars/{{calendar_id}}/rotate-feed
  body: none
  auth: bearer
}

auth:bearer {
  token: {{calendar_token}}
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("subscribe_url", res.body.subscribe_url);
  }
}

docs {
  Issues a new feed token: the old subscribe URL dies immediately.
  Updates the subscribe_url runtime variable, so Read feed keeps
  working.
}
