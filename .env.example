# calfeed configuration. Copy to .env and adjust.

# Required: token for creating calendars. Use a long random string,
# such as the output of: openssl rand -hex 32
CALFEED_ADMIN_TOKEN=

# Public base URL, used to build subscribe_url and webcal_url in responses.
CALFEED_BASE_URL=http://localhost:8787

# Port the server listens on.
PORT=8787
